  "narrative": {
    "northStar": "Signal console",
    "overview": "PaperCode uses a full-screen character-cell workspace with a centered launch composer and a docked composer during conversation. Signal is the default; Graphite, Midnight and Paper retain the same layout and semantic color roles.\n\nThis system follows the implemented React/Ink interface. Terminal settings own the font and cell metrics. The redesign is code-led; there is no approved raster composition.",
    "keyCharacteristics": [
      "Character-cell spacing and single-line box borders.",
      "A stable header, scrollable work area and one status row with width-bounded contextual hints.",
      "Semantic color, explicit labels and visible selection/caret markers."
    ],
    "rules": [
      {
        "name": "The active palette rule",
        "body": "Use theme roles for every frame, including erased line tails. [The CLI](src/cli.tsx) paints the actual background and default foreground, including Paper's light background.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do resolve every color through the active theme.",
      "Do keep long paths and model IDs within their allotted columns.",
      "Do preserve keyboard access to editing, approvals, selectors and scrollback.",
      "Do derive context, changed files and connection status from application state."
    ],
    "donts": [
      "Don't add pixel font sizes, web font stacks or CSS breakpoints to the terminal implementation.",
      "Don't replace state with fabricated context or integration counts.",
      "Don't animate theme selection or repeat the opening shine indefinitely.",
      "Don't rely on color alone for selection, errors or diff meaning."
    ]
  }
}
